newPatch
load @ROOT/Sound/@RTD/bulletair1.wav
priority -10
minDistance 5
randomStartPitch 0.05 / 0.05
*** Time Volume ***
beginEffect
	controlDestination Volume
	controlSource Time
	envelope Ramp
	param 0.075
	param 0.075
	param 0
	param 1	
endEffect
trigger Volume
dopplerOff

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 5
	param 10
	param 1
	param -1
endEffect 

