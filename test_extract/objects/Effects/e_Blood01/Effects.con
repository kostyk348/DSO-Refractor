

rem *** e_Blood01 ***
ObjectTemplate.create EffectBundle e_Blood01
ObjectTemplate.saveInSeparateFile 1
ObjectTemplate.loadSoundScript Sounds/richoblood.ssc
rem -------------------------------------
ObjectTemplate.addTemplate Em_blood01
ObjectTemplate.addTemplate Em_BloodSmoke
ObjectTemplate.timeToLive CRD_NONE/1.8/0/0
rem -------------------------------------


rem *** Em_blood01 ***
ObjectTemplate.create Emitter Em_blood01
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.template Fx_blood01
ObjectTemplate.addEmitterSpeed 1
ObjectTemplate.emitterSpeedScale 1
ObjectTemplate.lodDistance 200
ObjectTemplate.timeToLive CRD_NONE/0.1/0/0
ObjectTemplate.intensity CRD_UNIFORM/10/20/0
ObjectTemplate.relativePositionInDof CRD_NONE/0.1/0.1/0
ObjectTemplate.positionalSpeedInDof CRD_UNIFORM/0/0/0
ObjectTemplate.positionalSpeedInUp CRD_UNIFORM/1/0/0
ObjectTemplate.positionalSpeedInRight CRD_UNIFORM/0/0/0
ObjectTemplate.startRotation CRD_NONE/1/0/0


rem *** Fx_blood01 ***
ObjectTemplate.create SpriteParticle Fx_blood01
ObjectTemplate.timeToLive CRD_NONE/0.4/0.4/0
ObjectTemplate.size CRD_NONE/0.15/0.1/0
ObjectTemplate.gravityModifier CRD_NONE/0.1/0/0
ObjectTemplate.sizeOverTime 0/0.97|100/1
ObjectTemplate.texture e_Blood_4pcs
ObjectTemplate.initRotation CRD_UNIFORM/1/180/1
ObjectTemplate.destBlendMode BMInvSourceAlpha
ObjectTemplate.rotationSpeed CRD_UNIFORM/30/50/1
ObjectTemplate.colorRGBAOverTime 0/128/128/128/255|43/115/106/87/167|100/192/192/192/0
ObjectTemplate.numAnimationFrames 4
ObjectTemplate.initAnimationFrame CRD_NONE/2/0/0
ObjectTemplate.animationSpeed CRD_NONE/20/0/0


rem *** Em_BloodSmoke ***
ObjectTemplate.create Emitter Em_BloodSmoke
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.template Fx_BloodSmoke
ObjectTemplate.addEmitterSpeed 1
ObjectTemplate.emitterSpeedScale 1
ObjectTemplate.lodDistance 200
ObjectTemplate.timeToLive CRD_NONE/0.1/0/0
ObjectTemplate.intensity CRD_UNIFORM/10/20/0
ObjectTemplate.relativePositionInDof CRD_UNIFORM/0.1/0.1/1
ObjectTemplate.relativePositionInUp CRD_NONE/0.1/0.1/1
ObjectTemplate.positionalSpeedInDof CRD_NONE/1/0/0
ObjectTemplate.startRotation CRD_NONE/1/0/0


rem *** Fx_BloodSmoke ***
ObjectTemplate.create SpriteParticle Fx_BloodSmoke
ObjectTemplate.timeToLive CRD_NONE/0.3/0.3/0
ObjectTemplate.size CRD_NONE/0.15/0.2/0
ObjectTemplate.gravityModifier CRD_NONE/0.2/0/0
ObjectTemplate.drag CRD_NONE/0.2/0/0
ObjectTemplate.texture e_muzs2_I
ObjectTemplate.initRotation CRD_NONE/1/150/1
ObjectTemplate.srcBlendMode BMSourceColor
ObjectTemplate.destBlendMode BMInvSourceAlpha
ObjectTemplate.colorRGBAOverTime 0/192/192/192/102|61/192/192/192/39|100/192/192/192/0
