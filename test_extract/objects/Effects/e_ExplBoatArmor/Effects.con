

rem *** e_ExplBoatArmor ***
ObjectTemplate.create EffectBundle e_ExplBoatArmor
ObjectTemplate.saveInSeparateFile 1
ObjectTemplate.loadSoundScript Sounds/e_ExplBoatArmor.ssc
rem -------------------------------------
ObjectTemplate.addTemplate Em_ExplBoatArmor
ObjectTemplate.setRotation 90/0/0
ObjectTemplate.addTemplate Em_ExplBoatArmor_flash
ObjectTemplate.addTemplate Em_ExplBoatArmor_Cloud
ObjectTemplate.addTemplate Em_ExplBoatArmor_Smoke
ObjectTemplate.addTemplate Em_GibbSmokeSmoke
ObjectTemplate.timeToLive CRD_NONE/1.8/0/0
rem -------------------------------------


rem *** Em_ExplBoatArmor ***
