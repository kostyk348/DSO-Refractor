load @ROOT/Sound/@RTD/collside1.wav
minDistance 7
randomStartPitch 0.2 / 0.1
volume 1
stop FinishSample

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 10
	param 15
	param 1
	param -1	
endEffect


