newPatch
#########################################################################################################
### Main ###
############

load @ROOT/Sound/@RTD/newexpl3.wav
minDistance 40
randomStartPitch 0.05 / 0.05
volume .6

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 100
	param 130
	param 1
	param -1
endEffect


