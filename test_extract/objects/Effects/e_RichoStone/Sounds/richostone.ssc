newPatch
###############
### SOUND 1 ###
###############
load @ROOT/Sound/@RTD/stoneimpact1.wav
priority -10
minDistance 1
randomStartPitch 0.05 / 0.05
volume .9
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 3
	param 10
	param 1
	param -1	
endEffect


