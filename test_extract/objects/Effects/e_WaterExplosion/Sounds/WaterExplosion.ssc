newPatch
######################
### Close Distance ###
######################

load @ROOT/Sound/@RTD/uwexpl1.wav
minDistance 70
randomStartPitch 0.4 / 0.0


*** Offset Pitch ***
beginEffect
	controlDestination Pitch
	controlSource Default
	envelope Linear
	param 0.5
	param 0
endEffect


*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 130
	param 250
	param 1
	param -1
endEffect

