rem *** Plugins ***
aiTemplatePlugIn.create Cover IronBridgeCover
aiTemplatePlugIn.coverValue 2.0

aiTemplatePlugIn.create Physical IronBridgePhysical

rem *** AITemplate ***
aiTemplate.create Ironbrdg1_m1
aiTemplate.addType ITCover
aiTemplate.degeneration 1
aiTemplate.allowedTimeDiff -1
aiTemplate.basicTemp 1
aiTemplate.commonKnowledge 1
aiTemplate.addPlugIn IronBridgeCover
aiTemplate.addPlugIn IronBridgePhysical

aiTemplate.create Ironbrdg2_m1
aiTemplate.addType ITCover
aiTemplate.degeneration 1
aiTemplate.allowedTimeDiff -1
