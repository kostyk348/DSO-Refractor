newPatch
############
### Near ###
############
load @ROOT/Sound/@RTD/Factory_Rumble.wav
loop
minDistance 10
relativePosition 5/0/0
randomStartPitch 0.25 / 0.0
volume .6

*** Offset Pitch ***
beginEffect
	controlDestination Pitch
	controlSource Default
	envelope Linear
	param 0.9
	param 0
endEffect

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 30
	param 50
	param 1
	param -1	
endEffect


################
### Near/Far ###
################
load @ROOT/Sound/@RTD/Factory_Rumble.wav
loop
minDistance 10
relativePosition -5/0/0
randomStartPitch 0.25 / 0.0
volume .5

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 90
	param 129
	param 1
	param -1	
endEffect