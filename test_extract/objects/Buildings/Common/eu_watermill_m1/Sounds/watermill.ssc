newPatch
load @ROOT/Sound/@RTD/windmill.wav
loop
minDistance 1
randomStartPitch 0.3 / 0.0
volume .6
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 10
	param 40
	param 1
	param -1	
endEffect

load @ROOT/Sound/@RTD/watermillwater.wav
loop
minDistance 1
randomStartPitch 0.3 / 0.0
volume .7
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 10
	param 40
	param 1
	param -1	
endEffect
