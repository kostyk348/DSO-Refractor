rem *** Add Bazooka***
weaponTemplate.create BazookaRPG
weaponTemplate.burst 0
weaponTemplate.indirect 0
weaponTemplate.minRange 0.0
weaponTemplate.maxRange 100.0
weaponTemplate.weaponActivate PIMenuSelect3
