newPatch

load @ROOT/Sound/@RTD/Medkit.wav
minDistance 1
stereo
loop
stop FinishSample
dopplerOff
randomStartPitch 0.06 / 0.0
volume .8

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 1
	param 1
	param 1
	param -1
endEffect