	weaponTemplate.setStrength 2 0.0
	weaponTemplate.setStrength 3 0.0
	weaponTemplate.setStrength 4 0.0
	weaponTemplate.setStrength 5 4.9
	
	
	rem *** Add Coaxial Machine Gun ***
