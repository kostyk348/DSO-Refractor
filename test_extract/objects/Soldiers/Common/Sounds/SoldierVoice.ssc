###################################
### IStayOnDefense		###
###################################
newPatch
load @ROOT/Sound/@RTD/@Language/IStayOnDefense.wav
minDistance 10
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 20
	param 70
	param 1
	param -1	
endEffect

load @ROOT/Sound/@RTD/@Language/IStayOnDefenseALT.wav
minDistance 10
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 20
	param 70
	param 1
	param -1	
endEffect

randomPlay 1
priority 11

