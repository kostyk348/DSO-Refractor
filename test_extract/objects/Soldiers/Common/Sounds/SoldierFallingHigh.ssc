newPatch

load @ROOT/Sound/@RTD/rcktlp1.wav
loop
minDistance 1
randomStartPitch 0.05 / 0.05
volume.2

*** Engine start ***
beginEffect
	controlDestination Volume
	controlSource Time
	envelope Ramp
	param 0.1
	param 2.5
	param 0
	param 1
endEffect

*** Engine Pitch ***
beginEffect
	controlDestination Pitch
	controlSource Default
	envelope Linear
	param 0.1
	param 0.4
endEffect

*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 1
	param 3
	param 1
	param -1
endEffect

