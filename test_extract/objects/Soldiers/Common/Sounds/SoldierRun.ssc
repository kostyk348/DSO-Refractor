##############
### FABRIC ###
##############
newPatch

load @ROOT/Sound/@RTD/SoFaRun1.wav
randomStartPitch 0.03 / 0.03
minDistance 1
volume .3
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 1
	param 5
	param 1
	param -1	
endEffect

*** Time Delay ***
beginEffect
	controlDestination Volume
	controlSource Time
	envelope Ramp
	param 0.20
	param 0.20
	param 0
	param 1
endEffect

trigger Volume

