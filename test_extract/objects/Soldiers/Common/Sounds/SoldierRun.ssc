############
### SAND ###
############
newPatch

load @ROOT/Sound/@RTD/SOWASAND1.wav
randomStartPitch 0.03 / 0.03
minDistance 1
volume .6
*** Distance Volume ***
beginEffect
	controlDestination Volume
	controlSource Distance
	envelope Ramp
	param 2
	param 8
	param 1
	param -1	
endEffect

