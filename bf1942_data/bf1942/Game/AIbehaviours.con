rem *** Set number of behaviours and id/name mappings ***
aiSettings.setNBehaviours 8

aiSettings.setBehaviour 0 Avoid
aiSettings.setBehaviour 1 MoveTo
aiSettings.setBehaviour 2 Idle
aiSettings.setBehaviour 3 Fire
aiSettings.setBehaviour 4 Scout
aiSettings.setBehaviour 5 TakeCover
aiSettings.setBehaviour 6 Change
aiSettings.setBehaviour 7 Special

rem *** Set number of vehicles and id/name mappings ***
aiSettings.setNVehiclesTypes 15
aiSettings.setVehicle  0 Tank
aiSettings.setVehicle  1 Plane
aiSettings.setVehicle  2 Boat
aiSettings.setVehicle  3 Infantery
aiSettings.setVehicle  4 Fixed
aiSettings.setVehicle  5 Car
aiSettings.setVehicle  6 UnarmedTank
aiSettings.setVehicle  7 LandingCraft
aiSettings.setVehicle  8 Passenger
aiSettings.setVehicle  9 BoatFixed
aiSettings.setVehicle 10 LandingCraftPassenger
aiSettings.setVehicle 11 LandingCraftFixed
aiSettings.setVehicle 12 UnarmedBoat
aiSettings.setVehicle 13 FixedLargeBore
aiSettings.setVehicle 14 ArtilleryDriver

rem *** IMPORTANT !!! **************************
rem * NEVER ALLOW IDLE's urgency to become 0.  *
rem * The AI will CRASH in that case.          *
rem *** REMINDER *******************************

rem *** Construct unit weights ***
aiSettings.createBehaviourModifiers UnitWeights
aiSettings.setBehaviourModifier Avoid       1.0
aiSettings.setBehaviourModifier MoveTo      1.0
aiSettings.setBehaviourModifier Idle        1.0
aiSettings.setBehaviourModifier Fire        1.0
aiSettings.setBehaviourModifier Special     1.0
aiSettings.setBehaviourModifier Scout       1.0
aiSettings.setBehaviourModifier TakeCover   1.0
aiSettings.setBehaviourModifier Change      1.0

rem *** Construct standard weights ***
aiSettings.createBehaviourModifiers StandardWeights
aiSettings.setBehaviourModifier Avoid       1.0
aiSettings.setBehaviourModifier MoveTo      1.5
aiSettings.setBehaviourModifier Idle        0.1
aiSettings.setBehaviourModifier Fire        6.0
aiSettings.setBehaviourModifier Special     1.0
aiSettings.setBehaviourModifier Scout       0.5
aiSettings.setBehaviourModifier TakeCover   4.0
aiSettings.setBehaviourModifier Change      1.3

rem *** Construct plane weights ***
aiSettings.createBehaviourModifiers PlaneWeights
aiSettings.setBehaviourModifier Avoid       0.0
aiSettings.setBehaviourModifier MoveTo      1.0
aiSettings.setBehaviourModifier Idle        0.1
aiSettings.setBehaviourModifier Fire        1.5
aiSettings.setBehaviourModifier Special     1.0
aiSettings.setBehaviourModifier Scout       1.0
aiSettings.setBehaviourModifier TakeCover   0.0
aiSettings.setBehaviourModifier Change      0.0

rem *** Construct Avoid inhibitors ***
aiSettings.createBehaviourModifiers AvoidInhibit
aiSettings.setBehaviourModifier Avoid       1.0
aiSettings.setBehaviourModifier MoveTo      0.3
aiSettings.setBehaviourModifier Idle        1.0
aiSettings.setBehaviourModifier Fire        1.0
aiSettings.setBehaviourModifier Special     0.5
aiSettings.setBehaviourModifier Scout       1.0
aiSettings.setBehaviourModifier TakeCover   1.0
aiSettings.setBehaviourModifier Change      1.0

rem *** Construct Change Inhibit ***
aiSettings.createBehaviourModifiers ChangeInhibit
aiSettings.setBehaviourModifier Avoid       0.8
aiSettings.setBehaviourModifier MoveTo      0.0
aiSettings.setBehaviourModifier Idle        0.01
aiSettings.setBehaviourModifier Fire        0.75
aiSettings.setBehaviourModifier Special     0.0
aiSettings.setBehaviourModifier Scout       0.5
aiSettings.setBehaviourModifier TakeCover   1.0
aiSettings.setBehaviourModifier Change      1.0

rem *** Set basic weights for bot behaviour ***
aiSettings.setBasicBotWeights UnitWeights
aiSettings.setStandardPersonality StandardWeights 1
aiSettings.setStandardPersonality StandardWeights 2
aiSettings.setStandardMoralAdmin default 1
aiSettings.setStandardMoralAdmin default 2

rem ************************* Vehicle behaviour setup ******************************

aiSettings.createUCConstant UCUnion 1.0
aiSettings.createUCLinear UCFire -0.22 1.3
aiSettings.createUCXInverse UCScout 2.5 0.9 1.0 0.5
aiSettings.createUCConstant UCScoutLimit 1.0

rem        setVehicleBehaviour VehicleName      Behaviour       UrgencyGenerator        PlanGenerator                   Prio ParallellMask UrgencyCurve Inhibitors

rem *** Tank Behaviour setup ***
aiSettings.setVehicleBehaviour Tank		Avoid		BBAvoid			BBPAvoidCollision2d		1 0 UCUnion AvoidInhibit
aiSettings.setVehicleBehaviour Tank		MoveTo		BBMoveTo		BBPGotoWaypoint2d		4 0 UCUnion UnitWeights
aiSettings.setVehicleBehaviour Tank		Idle		BBIdle			BBPIdle2d			5 0 UCUnion UnitWeights
